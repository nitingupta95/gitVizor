# ==============================================================================
# Database
# ==============================================================================
# Prisma connection string with pooling enabled (e.g. Neon serverless endpoint)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&pgbouncer=true"
# Direct connection string for Prisma migrations
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ==============================================================================
# Clerk Authentication
# ==============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# ==============================================================================
